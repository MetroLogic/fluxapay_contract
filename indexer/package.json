{
  "name": "@fluxapay/indexer",
  "version": "1.0.0",
  "description": "FluxaPay Soroban event indexer for PostgreSQL",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "start:api": "node dist/server.js",
    "dev:api": "ts-node src/server.ts",
    "build": "tsc",
    "migrate": "node dist/migrations/run.js",
    "migrate:up": "node dist/migrations/run.js up",
    "migrate:down": "node dist/migrations/run.js down",
    "migrate:down:all": "node dist/migrations/run.js down:all",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:studio": "drizzle-kit studio",
    "watch": "tsc --watch",
    "load-test": "k6 run tests/load/payment-confirm.js",
    "test": "ts-node --test test/webhooks.test.ts test/rate-limit.test.ts && jest"
  },
  "keywords": ["soroban", "indexer", "stellar", "postgres"],
  "author": "FluxaPay",
  "license": "MIT",
  "dependencies": {
    "stellar-sdk": "12.0.0",
    "pg": "8.11.0",
    "dotenv": "16.3.1",
    "express": "4.19.2",
    "zod": "3.23.8",
    "drizzle-orm": "0.39.3"
  },
  "devDependencies": {
    "@types/pg": "8.10.9",
    "@types/node": "20.11.0",
    "@types/express": "4.17.21",
    "@types/jest": "^29.5.11",
    "typescript": "5.3.0",
    "ts-node": "10.9.2",
    "drizzle-kit": "0.30.4",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "nock": "^13.5.1"
  }
}
