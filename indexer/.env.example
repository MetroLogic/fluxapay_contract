# FluxaPay Indexer Environment Configuration

# Soroban RPC endpoint
SOROBAN_RPC_URL=http://localhost:8000/soroban/rpc

# --- Multi-Contract Configuration (Issue #618) ---
# Subscribes to events across all 5 FluxaPay contracts simultaneously.
# Individual contract variables:
PAYMENT_PROCESSOR_CONTRACT_ID=CBNR5IXY5K7KCJ63PY3ZFYHG4U6F5C5I2PZ2ZQXDMQQNC6ZF63K65QQ
REFUND_MANAGER_CONTRACT_ID=CDRF5IXY5K7KCJ63PY3ZFYHG4U6F5C5I2PZ2ZQXDMQQNC6ZF63K65QQ
MERCHANT_REGISTRY_CONTRACT_ID=CMRC5IXY5K7KCJ63PY3ZFYHG4U6F5C5I2PZ2ZQXDMQQNC6ZF63K65QQ
FX_ORACLE_CONTRACT_ID=CFXO5IXY5K7KCJ63PY3ZFYHG4U6F5C5I2PZ2ZQXDMQQNC6ZF63K65QQ
PAYMENT_LINK_MANAGER_CONTRACT_ID=CPLM5IXY5K7KCJ63PY3ZFYHG4U6F5C5I2PZ2ZQXDMQQNC6ZF63K65QQ

# Alternatively, specify a comma-separated list of contract IDs:
CONTRACT_IDS=

# Legacy single contract ID fallback (migrated cleanly to contractIds array):
FLUXAPAY_CONTRACT_ID=

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:password@localhost:5432/fluxapay

# Poll interval in milliseconds (default: 5000)
POLL_INTERVAL_MS=5000

# Starting ledger (default: 1, use 0 for latest)
START_LEDGER=0

# --- REST API Configuration (Issue #616) ---
PORT=3001
INDEXER_API_PORT=3001

# API Key Authentication (x-api-key header or Authorization: Bearer <API_KEY>)
API_KEY=fluxapay_secret_api_key
INDEXER_API_KEY=fluxapay_secret_api_key

# --- Dead-Letter Queue Configuration (Issue #617) ---
# Interval for automatic DLQ retry in milliseconds (default: 60000)
DLQ_RETRY_INTERVAL_MS=60000

# Minimum age in seconds before a DLQ event is eligible for automatic retry (default: 60)
DLQ_MIN_AGE_SECONDS=60
