# FluxaPay Indexer Configuration

# Soroban RPC endpoint
SOROBAN_RPC_URL=http://localhost:8000/soroban/rpc

# FluxaPay contract ID
FLUXAPAY_CONTRACT_ID=CBNR5IXY5K7KCJ63PY3ZFYHG4U6F5C5I2PZ2ZQXDMQQNC6ZF63K65QQ

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:password@localhost:5432/fluxapay

# Poll interval in milliseconds (default: 5000)
POLL_INTERVAL_MS=5000

# Starting ledger (default: 1, use 0 for latest)
START_LEDGER=0

# --- REST API auth (Issue #672: SEP-10) ---

# Port for the indexer REST API (npm run dev:api / start:api)
INDEXER_API_PORT=3001

# SEP-10 Web Authentication endpoint clients use to obtain a JWT
STELLAR_WEB_AUTH_ENDPOINT=https://testanchor.stellar.org/auth

# Home domain asserted in the SEP-10 challenge
STELLAR_HOME_DOMAIN=fluxapay.stellar.org

# Stellar public key (G...) used to verify JWTs issued after SEP-10 auth;
# must match the key used by the SEP-10 auth server (see sdk/src/sep10.ts)
STELLAR_SERVER_PUBLIC_KEY=

# Comma-separated Stellar accounts (G...) allowed to call admin-only endpoints
INDEXER_ADMIN_ACCOUNTS=
