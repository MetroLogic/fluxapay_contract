PORT=3001

# Stellar account used to sign SEP-10 challenge transactions.
SEP10_SERVER_PUBLIC_KEY=G...
SEP10_HOME_DOMAIN=fluxapay.stellar.org

# testnet | mainnet
STELLAR_NETWORK=testnet

# Fee-bump daemon: how long (seconds) a payment may stay Pending before
# the daemon attempts a Stellar Fee-Bump transaction (CAP-0015).
FEE_BUMP_THRESHOLD_SECS=30

# Maximum fee (in stroops) FluxaPay will pay to bump a stuck transaction.
# Deducted from FluxaPay's operational fee account, not the merchant.
FEE_BUMP_MAX_STROOPS=100000
# Stellar Horizon RPC endpoints. HORIZON_URL is the primary endpoint;
# HORIZON_FALLBACK_1 and HORIZON_FALLBACK_2 are used automatically if the
# primary is unavailable (maintenance, rate limiting, regional outage).
HORIZON_URL=https://horizon-testnet.stellar.org
HORIZON_FALLBACK_1=https://horizon.stellar.org
HORIZON_FALLBACK_2=
