PORT=3001

# Stellar account used to sign SEP-10 challenge transactions.
SEP10_SERVER_PUBLIC_KEY=G...
SEP10_HOME_DOMAIN=fluxapay.stellar.org

# testnet | mainnet
STELLAR_NETWORK=testnet

# Stellar Horizon RPC endpoints. HORIZON_URL is the primary endpoint;
# HORIZON_FALLBACK_1 and HORIZON_FALLBACK_2 are used automatically if the
# primary is unavailable (maintenance, rate limiting, regional outage).
HORIZON_URL=https://horizon-testnet.stellar.org
HORIZON_FALLBACK_1=https://horizon.stellar.org
HORIZON_FALLBACK_2=
