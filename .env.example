# Stellar Network Configuration
# Allowed values: testnet, mainnet
STELLAR_NETWORK=testnet

# Stellar RPC URL
# Testnet: https://soroban-testnet.stellar.org
# Mainnet: https://soroban-rpc.stellar.org
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Stellar Horizon URL
# Testnet: https://horizon-testnet.stellar.org
# Mainnet: https://horizon.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Admin Secret Key for contract operations
# WARNING: Never commit real secret keys to version control.
# Generate a test keypair using: stellar keys generate
#
# SECURITY: This file is loaded by Docker Compose via `env_file:` (see
# indexer/docker-compose.yml). It is NOT bind-mounted into the container, so
# the host file cannot be modified from inside a compromised container.
# Keep this file out of version control (it is gitignored) and restrict its
# permissions on the host, e.g.: chmod 600 .env
STELLAR_SECRET_KEY=<YOUR_ADMIN_SECRET_KEY_HERE>

# Contract IDs deployed on the network
# These are written automatically by scripts/deploy-testnet.sh
# You can also find them in DEPLOYMENT.md or the deployment output.
FX_ORACLE_CONTRACT_ID=<FX_ORACLE_CONTRACT_ID>
MERCHANT_REGISTRY_CONTRACT_ID=<MERCHANT_REGISTRY_CONTRACT_ID>
PAYMENT_PROCESSOR_CONTRACT_ID=<PAYMENT_PROCESSOR_CONTRACT_ID>
REFUND_MANAGER_CONTRACT_ID=<REFUND_MANAGER_CONTRACT_ID>
PAYMENT_LINK_MANAGER_CONTRACT_ID=<PAYMENT_LINK_MANAGER_CONTRACT_ID>

# Legacy aliases (kept for backward compatibility with older tooling)
PAYMENT_PROCESSOR_ID=<PAYMENT_PROCESSOR_CONTRACT_ID>
MERCHANT_REGISTRY_ID=<MERCHANT_REGISTRY_CONTRACT_ID>
FX_ORACLE_ID=<FX_ORACLE_CONTRACT_ID>
REFUND_MANAGER_ID=<REFUND_MANAGER_CONTRACT_ID>

# Admin Account Address (public key)
# Used for verification and admin operations
ADMIN_ADDRESS=<ADMIN_PUBLIC_ADDRESS>

# Test/Development Merchant Address
# Used for testing merchant operations locally
TEST_MERCHANT_ADDRESS=<TEST_MERCHANT_PUBLIC_ADDRESS>

# Test/Development Customer Address
# Used for testing payment flows locally
TEST_CUSTOMER_ADDRESS=<TEST_CUSTOMER_PUBLIC_ADDRESS>

# Indexer API rate limiting (Issue #817)
# Auth routes (/v1/auth/*): requests per minute per IP
RATE_LIMIT_AUTH_RPM=10
# Authenticated API routes: requests per minute per account (API key)
RATE_LIMIT_API_RPM=200
